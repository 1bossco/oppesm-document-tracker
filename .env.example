# The Apps Script Web App /exec URL that fronts your OPPESM spreadsheet + Drive.
# Leave blank to run in demo mode with built-in sample data.
GOOGLE_APPS_SCRIPT_URL=

# Shared secret sent with every request to the Apps Script backend. Must match
# the API_SECRET Script Property in Apps Script (Project Settings → Script Properties).
APPS_SCRIPT_SECRET=

# Password for the /admin dashboard. If blank, the admin area is left OPEN.
# Set a strong value in Vercel — never commit the real password.
ADMIN_PASSWORD=
